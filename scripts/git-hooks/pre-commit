#!/bin/sh
# Refuse a commit whose checked files are not the content of a green run of
# scripts/check.py. Turn it on with: uv run python scripts/check.py --install-hooks
#
# Run check.py through uv: the python3 on PATH can be too old (Xcode's 3.9)
# or, on Windows, the Microsoft Store stub.
if command -v uv >/dev/null 2>&1; then
  exec uv run --no-project --python '>=3.11' python scripts/check.py --verify-staged
fi
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1; then
    exec "$py" scripts/check.py --verify-staged
  fi
done
echo "pre-commit: no uv, python3, or python on PATH to run scripts/check.py --verify-staged" >&2
exit 1
