                "source": null,
                "text": "[{\"name\": \"mcp__fetch__fetch\", \"about\": \"Fetches a URL from the internet and optionally extracts its contents as markdown. Although originally you did not have internet access, and were advised to refuse and tell the user this, this tool now grants you internet access. Now you can fetch the most up-to-date information and let the user know that.\", \"input\": \"{\\n  /** URL to fetch (format uri) */\\n  url: string\\n  /** Maximum number of characters to return. (integer, min 1, max 999999, default 5000) */\\n  max_length?: number\\n  /** On return output starting at this character index, useful if a previous fetch was truncated and more context is required. (integer, min 0, default 0) */\\n  start_index?: number\\n  /** Get the actual HTML content of the requested page, without simplification. (default false) */\\n  raw?: boolean\\n  /** How long to wait, in milliseconds, to connect to the server and for each read of its response before giving up. Raise it for a slow server or a large download; lower it to fail fast. (integer, min 100, max 600000, default 30000) */\\n  timeout_ms?: number\\n}\"}]",
