            "code_run": {
              "background": true,
              "code": "const start = Date.now();\nlet found = null, lastErr = null;\nwhile (Date.now() - start < 120000) {\n  try {\n    const r = await searchTools(\"fetch url\");\n    const list = Array.isArray(r) ? r : [];\n    found = list.find(t => /fetch/i.test(t.name));\n    if (found) {\n      try {\n        const res = await tools[found.name]({url: \"https://example.com\"});\n        var out = res;\n        break;\n      } catch (e) { lastErr = e.message; found = null; }\n    }\n  } catch (e) { lastErr = e.message; }\n  await sleep(5000);\n}\nif (!found) throw new Error(\"fetch failed: \" + lastErr);\nlet text = typeof out === \"string\" ? out : JSON.stringify(out);\nconst r = await $`wc -w <<'EOF_PAGE'\n${{raw: \"\"}}${text.replace(/\\$/g, \"\")}\nEOF_PAGE`.text();\nr.trim()",
